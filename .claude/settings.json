{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_sprite_art.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking sprite artwork policy"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_named_parameters.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking named gameplay and artwork parameters"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_allocations.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking per-frame allocation"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_style_hook.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the style-system gates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_sprite_art.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking sprite artwork policy"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_named_parameters.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking named gameplay and artwork parameters"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_allocations.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking per-frame allocation"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/check_style_hook.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the style-system gates"
          }
        ]
      }
    ]
  }
}
